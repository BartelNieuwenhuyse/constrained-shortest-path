<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Benchmark</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="TargetFramework" Value="$(TargetFramework)" />
    <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\CSP\DCSP-lDAGs\DelayConstrainedShortestPath.csproj" />
    <ProjectReference Include="..\..\..\src\DataStructures\DataStructures.csproj" />
    <ProjectReference Include="..\..\Input\InputGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
